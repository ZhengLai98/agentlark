# ---- 飞书应用 (必填) ----
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=

# ---- 模型工作目录 (必填, 没有默认值) ----
# 模型子进程的 cwd。它以 bypassPermissions 跑在这里, 目录内的文件它都读得到,
# 所以绝对不能指向本仓库根目录或其上级 —— 那样 .env 里的 FEISHU_APP_SECRET
# 与 user-data/runtime/sessions.json 就直接暴露给任何能给机器人发消息的人。
# 启动时会校验, 违规直接退出。填一个独立的代码目录, 例如 /Users/you/repos/web-main
WORKSPACE_DIR=

# 留空则启动时自动调 bot/v3/info 解析; 拿不到则群聊 @ 检测失效
FEISHU_BOT_OPEN_ID=

# ---- 模型子进程 ----
# claude 可执行文件路径; launchd 托管时 PATH 不含 ~/.local/bin, 建议写绝对路径
AGENT_BIN=claude
# 留空由 ~/.claude/settings.json 决定
AGENT_MODEL=
# 单次调用超时 (ms)
AGENT_TIMEOUT_MS=120000
# 模型权限模式; 真正的闸门是审批 hook (Plan 3), 现在等于完全写权限
AGENT_PERMISSION_MODE=bypassPermissions
# 流式卡片刷新节流 (ms)
AGENT_STREAM_THROTTLE_MS=500

# ---- 消息接入 ----
# 忽略 @全体成员
IGNORE_AT_ALL=true
# 群白名单, 逗号分隔; 留空 = 允许全部群
ALLOWED_GROUP_CHATS=
# 人白名单 (open_id, 私聊发 /whoami 可查), 逗号分隔; 留空 = 允许全部人
# Plan 3 的审批闸门落地前, 这是唯一能挡住「租户里任何人都能用本机 shell」的开关,
# 强烈建议填上自己和少数同事的 open_id
ALLOWED_USERS=

# ---- 会话 ----
# 会话空闲超时 (小时), 0 = 不限
SESSION_MAX_IDLE_HOURS=24

# ---- 日志 ----
LOG_LEVEL=info

# ---- 以下为后续计划占位, Plan 1 未读取 ----
# 挂载给模型的代码仓库, 数量不限: 别名:绝对路径, 逗号分隔; 留空跳过挂载 (Plan 2)
# REPO_PATHS=web-main:/Users/you/repos/web-main,mobile-app:/Users/you/repos/mobile-app
